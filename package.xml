<?xml version="1.0"?>
<package format="3">
  <name>zed2i_data_acquisition</name>
  <version>0.0.0</version>
  <description>ZED 2i point cloud acquisition and ros2 bag recording tools.</description>

  <maintainer email="werikson.alves@ufv.br">Werikson Alves</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>

  <!-- Open3D não é dependência ROS, instala via pip -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
</package>

